#!/bin/sh
# Opt-in pre-commit check: ruff and mypy only, so it stays fast (tests run with `python -m brownstone gates`).
# Install once per clone: git config core.hooksPath tools/git-hooks
# Skip once with: git commit --no-verify
root=$(git rev-parse --show-toplevel)
common=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)  # The main checkout, whose .venv worktrees share.
for python in "$root/.venv/bin/python" "$root/.venv/Scripts/python.exe" \
              "$common/.venv/bin/python" "$common/.venv/Scripts/python.exe"; do
    [ -x "$python" ] && break
done
[ -x "$python" ] || { echo "pre-commit: no .venv Python found; skipping ruff and mypy" >&2; exit 0; }
cd "$root" && exec "$python" -m brownstone gates --lint-only

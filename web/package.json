{
  "name": "brownstone-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "eslint . && tsc --noEmit && vitest run && node scripts/schema.mjs --check",
    "schema": "node scripts/schema.mjs",
    "format": "prettier --write src scripts *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.2",
    "cmdk": "1.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/bricolage-grotesque": "5.2.8",
    "prettier": "3.6.2"
  }
}
